export DEVENV_IN_DIRENV_SHELL=true
# Machine-specific settings such as NIX_SYSTEM_FLAKE (used below)
dotenv_if_exists .env.local

# We load .env.develoment.local before anything else so that
# users can override any settings in this file to configure
# services in flake.nix
dotenv .env.development.local

if ! has nix_direnv_version || ! nix_direnv_version 2.2.1; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/2.2.1/direnvrc" "sha256-zelF0vLbEl5uaqrfIzbgNzJWGmLzCmYAkInj/LNxvKs="
fi

watch_file nix/flake.nix
watch_file nix/flake.lock

# if ! use flake path:$(realpath ./nix) --impure; then
#   echo "devenv could not be built. The devenv environment was not loaded. Make the necessary changes to devenv.nix and hit enter to try again." >&2
# fi

watch_file .env.local

if [[ -n "${NIX_SYSTEM_FLAKE:-}" ]]; then
  # Resolve the system flake's *nixpkgs* input — not the system flake itself
  # (system flakes don't export lib/legacyPackages).
  NIXPKGS_OVERRIDE="$(
    nix flake metadata "${NIX_SYSTEM_FLAKE}" --json \
      | jq -r '
          .locks.nodes[.locks.nodes.root.inputs.nixpkgs].locked as $n
          | if $n.type == "github" then
              "github:\($n.owner)/\($n.repo)/\($n.rev)"
            elif $n.type == "path" then
              "path:\($n.path)"
            elif $n.type == "git" then
              "git+\($n.url)?rev=\($n.rev)"
            else
              error("unsupported nixpkgs locked type: \($n.type)")
            end
        '
  )"
  echo "⚠️  Using system flake nixpkgs override: ${NIXPKGS_OVERRIDE}" >&2
  if ! use flake "path:$(realpath ./nix)" \
    --override-input nixpkgs "${NIXPKGS_OVERRIDE}" \
    --impure; then
    echo "devenv could not be built (with system flake override). The devenv environment was not loaded." >&2
  fi
else
  if ! use flake "path:$(realpath ./nix)" --impure; then
    echo "devenv could not be built. The devenv environment was not loaded. Make the necessary changes to devenv.nix and hit enter to try again." >&2
  fi
fi
