#!/bin/bash
#
# Start the "Deploy WordPress" GitHub Actions workflow and follow its progress
#
# Usage: bin/deploy <staging|production> [--ref <branch>] [--no-watch]
#
# Examples:
#   bin/deploy production                 # Deploy main to production and watch the run
#   bin/deploy staging --ref my-branch    # Deploy a pushed branch to staging
#   bin/deploy production --no-watch      # Start the run and return immediately
#
# The workflow deploys what is on GitHub, not your local working tree,
# so push your commits first. Requires the GitHub CLI (gh), logged in.
#
# TODO Before the first run:
#   - Configure the workflow: follow the TODOs at the top of .github/workflows/deploy.yml
#     (GitHub environments, their secrets and variables). The run fails without them.
#   - Push .github/workflows/deploy.yml to the default branch (main). GitHub only
#     dispatches workflows that exist there, and --ref must also contain the file.
#   - Install the GitHub CLI and run `gh auth login` with an account that can run
#     workflows in this repository. Run this script from a clone whose `origin` is
#     that GitHub repository; gh picks the repository from it.
#   - If your default branch isn't main, change REF=main below.
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
WORKFLOW="deploy.yml"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

usage() {
  sed -n '5,10p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

ENVIRONMENT=
REF=main
WATCH=true
while [[ $# -gt 0 ]]; do
  case "$1" in
    staging|production) ENVIRONMENT="$1" ;;
    --ref) REF="$2"; shift ;;
    --no-watch) WATCH=false ;;
    *) usage ;;
  esac
  shift
done
[[ -n "$ENVIRONMENT" && -n "$REF" ]] || usage

if ! command -v gh >/dev/null; then
  echo -e "${RED}gh not found. Install the GitHub CLI and run 'gh auth login'.${NC}" >&2
  exit 1
fi

cd "$PROJECT_ROOT"

# Warn when the branch on GitHub differs from the local one, since GitHub deploys its copy
if git fetch --quiet origin "$REF" 2>/dev/null && git rev-parse --verify --quiet "$REF" >/dev/null; then
  LOCAL=$(git rev-parse "$REF")
  REMOTE=$(git rev-parse FETCH_HEAD)
  if [[ "$LOCAL" != "$REMOTE" ]]; then
    echo -e "${YELLOW}Warning: local $REF ($(git rev-parse --short "$LOCAL")) differs from origin/$REF ($(git rev-parse --short "$REMOTE")).${NC}"
    echo -e "${YELLOW}The workflow deploys origin/$REF.${NC}"
  fi
fi

echo -e "Deploying ${GREEN}$REF${NC} ($(git log -1 --format='%h %s' FETCH_HEAD 2>/dev/null || echo "origin/$REF")) to ${GREEN}$ENVIRONMENT${NC}"
if [[ "$ENVIRONMENT" == "production" ]]; then
  read -r -p "Continue? [y/N] " REPLY
  [[ "$REPLY" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 1; }
fi

STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
gh workflow run "$WORKFLOW" --ref "$REF" -f environment="$ENVIRONMENT"

[[ "$WATCH" == true ]] || exit 0

# GitHub takes a moment to create the run; find the one started after the dispatch
RUN_ID=
for _ in {1..15}; do
  sleep 2
  RUN_ID=$(gh run list --workflow "$WORKFLOW" --event workflow_dispatch --branch "$REF" --limit 1 \
    --json databaseId,createdAt --jq ".[] | select(.createdAt >= \"$STARTED_AT\") | .databaseId")
  [[ -n "$RUN_ID" ]] && break
done

if [[ -z "$RUN_ID" ]]; then
  echo -e "${YELLOW}Run started, but it did not appear yet. Check: gh run list --workflow $WORKFLOW${NC}"
  exit 0
fi

gh run watch "$RUN_ID" --exit-status
