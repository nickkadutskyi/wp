#!/bin/bash
# Find wp-cli: wp-cli.phar in project root, then vendor/bin/wp, then wp in PATH
WP=
if [[ -f "./wp-cli.phar" ]]; then
  # Hide PHP deprecations, which PHP prints to stdout
  WP="php -d error_reporting=E_ALL^E_DEPRECATED ./wp-cli.phar"
elif [[ -x "vendor/bin/wp" ]]; then
  WP="vendor/bin/wp"
elif command -v wp >/dev/null; then
  WP=$(command -v wp)
else
  echo "wp-cli not found" >&2
  exit 1
fi

echo "Using wp-cli: $($WP --info | grep 'WP-CLI version')"

# Keep only the version number; wp-cli may print PHP notices to stdout too
CURRENT_VERSION=$($WP core version 2>/dev/null | grep -Eo '^[0-9]+(\.[0-9]+)+' | tail -n1)

if [ -z "$CURRENT_VERSION" ]; then
  echo "WordPress core is not installed"
else
  echo "Currently installed WordPress core version: $CURRENT_VERSION"
fi

$WP core download --force 2> /dev/null
