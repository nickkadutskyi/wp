#!/bin/bash
# Find wp-cli: wp-cli.phar in project root, then vendor/bin/wp, then wp in PATH
WP=
if [[ -f "./wp-cli.phar" ]]; then
  # Hide PHP deprecations, which PHP prints to stdout
  WP="php -d error_reporting=E_ALL^E_DEPRECATED ./wp-cli.phar"
elif [[ -x "vendor/bin/wp" ]]; then
  WP="vendor/bin/wp"
elif command -v wp >/dev/null; then
  WP=$(command -v wp)
else
  echo "wp-cli not found" >&2
  exit 1
fi

echo "Using wp-cli: $($WP --info | grep 'WP-CLI version')"

# Print only the version number; wp-cli may print PHP notices to stdout too
wp_version() {
  $WP core version 2>/dev/null | grep -Eo '^[0-9]+(\.[0-9]+)+' | tail -n1
}

CURRENT_VERSION=$(wp_version)
# Update core files
$WP core update "$@" 2>/dev/null
# Update database
$WP core update-db 2>/dev/null
NEW_VERSION=$(wp_version)

if [[ -z "$CURRENT_VERSION" || -z "$NEW_VERSION" ]]; then
  echo "Could not read the WordPress core version" >&2
  exit 1
fi

if [ "$NEW_VERSION" != "$CURRENT_VERSION" ]; then
  sed -i'.original' -E "s/^([[:space:]]*version:[[:space:]]*).*/\1$NEW_VERSION/" ./wp-cli.yml
  rm ./wp-cli.yml.original
  echo "WordPress Core updated from $CURRENT_VERSION to $NEW_VERSION"
else
  echo "No update needed, current version is already $CURRENT_VERSION"
fi
